# Copy to .env.local and fill in. .env.local is git-ignored.
# Never commit real values, and never hardcode a key into a source file.
# Vite reads this file at startup only — restart `npm run dev` after editing.
# Full walkthrough: docs/COLLABORATOR_SETUP.md

# ── Client (safe to ship in the browser bundle) ──────────────────────────
# The anon key is a publishable key. It is protected by Row Level Security,
# which is why it may appear in client code.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=
# reCAPTCHA v2 "I'm not a robot" checkbox site key.
# Get a free pair at https://www.google.com/recaptcha/admin/create and add
# `localhost` under Domains, or use Google's universal test keys for UI work.
VITE_RECAPTCHA_SITE_KEY=
# Unused — the app calls /api/* on the same origin. Kept for reference only.
VITE_API_BASE_URL=

# ── Server and maintenance scripts (SECRET, never in the browser) ────────
# The service role key bypasses Row Level Security completely. Treat it as a
# full database password. It belongs only here and in your host's secret
# store, never in a source file or a commit.
SUPABASE_SERVICE_ROLE_KEY=
# Must be from the SAME reCAPTCHA key pair as VITE_RECAPTCHA_SITE_KEY.
RECAPTCHA_SECRET_KEY=
GEMINI_API_KEY=
GMAIL_USER=
# A Google *app password*, not the account password.
GMAIL_APP_PASSWORD=

# ── Optional ─────────────────────────────────────────────────────────────
# Hosts the login route accepts a reCAPTCHA token from. Comma-separated.
# Defaults to: cuenta-sk-budget-system.vercel.app,localhost
# Add a LAN IP or tunnel host here if you test the dev server from a phone.
RECAPTCHA_ALLOWED_HOSTNAMES=
